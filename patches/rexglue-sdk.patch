+bool CommandProcessor::SubmitCommandStream(const uint8_t* data, uint32_t size_bytes) {
+  if (!worker_running_) {
+    return false;
+  }
+  if (!data) {
+    // Synchronization requests:
+    //   size 0: wait until everything submitted so far has executed.
+    //   size 1: frame boundary - wait until everything submitted before the
+    //           previous boundary has executed (keeps at most one frame of
+    //           work queued ahead of the command processor).
+    if (system::XThread::IsInThread(worker_thread_.get())) {
+      return true;
+    }
+    if (size_bytes == 0) {
+      return WaitDone(submit_seq.load(), worker_running_);
+    }
+    const uint64_t previous = frame_mark_seq;
+    frame_mark_seq = submit_seq.load();
+    return WaitDone(previous, worker_running_);
+  }
+  if (!size_bytes || (size_bytes & 3)) {
+    return false;
+  }
+  // A spare dword distinguishes the full linear stream from an empty ring.
+  auto bytes = std::make_shared<std::vector<uint8_t>>(size_bytes + 4);
+  std::memcpy(bytes->data(), data, size_bytes);
+  const uint64_t seq = submit_seq.fetch_add(1) + 1;
+  const uint64_t submit_start = NowUs();
+  CallInThread([this, bytes, size_bytes, seq]() {
+    const uint64_t exec_start = NowUs();
+    memory::RingBuffer reader(bytes->data(), bytes->size());
+    reader.set_write_offset(size_bytes);
+    ExecutePacketsResync(&reader);
+    OnPrimaryBufferEnd();
+    stat_exec_us.fetch_add(NowUs() - exec_start, std::memory_order_relaxed);
+    MarkDone(seq);
+  });
+  stat_count.fetch_add(1, std::memory_order_relaxed);
+  stat_bytes.fetch_add(size_bytes, std::memory_order_relaxed);
+  if (REXCVAR_GET(gpu_async_submit)) {
+    MaybeLogStats();
+    return true;
+  }
+  // With a queue depth of N, return once everything up to N streams back has
+  // executed, so the submitting thread prepares the next stream while the
+  // command processor executes this one.
+  const int32_t depth = std::max(REXCVAR_GET(gpu_async_depth), 0);
+  const uint64_t need = seq > uint64_t(depth) ? seq - uint64_t(depth) : 0;
+  const bool ok = need == 0 || WaitDone(need, worker_running_);
+  stat_wait_us.fetch_add(NowUs() - submit_start, std::memory_order_relaxed);
+  MaybeLogStats();
+  if (!ok) {
+    REXGPU_ERROR("Command stream submission timed out");
+    return false;
+  }
+  return true;
+}
