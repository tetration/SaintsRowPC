+namespace {
+// Submission bookkeeping for SubmitCommandStream (there is one command
+// processor).
+std::atomic<uint64_t> submit_seq{0};
+std::atomic<uint64_t> done_seq{0};
+std::mutex done_mutex;
+std::condition_variable done_cv;
+uint64_t frame_mark_seq = 0;
+
+// Statistics (logged every few seconds): submissions, time spent executing
+// them on the command processor thread, and time submitters spent waiting.
+std::atomic<uint64_t> stat_count{0};
+std::atomic<uint64_t> stat_bytes{0};
+std::atomic<uint64_t> stat_exec_us{0};
+std::atomic<uint64_t> stat_wait_us{0};
+std::atomic<int64_t> stat_last_log{0};
+std::atomic<uint64_t> stat_regwait_count{0};
+std::atomic<uint64_t> stat_regwait_us{0};
+
+uint64_t NowUs() {
+  return uint64_t(std::chrono::duration_cast<std::chrono::microseconds>(
+                      std::chrono::steady_clock::now().time_since_epoch())
+                      .count());
+}
+
+void MaybeLogStats() {
+  const int64_t now = int64_t(NowUs());
+  int64_t last = stat_last_log.load();
+  if (now - last < 2000000 || !stat_last_log.compare_exchange_strong(last, now)) {
+    return;
+  }
+  const double seconds = last ? (now - last) / 1e6 : 2.0;
+  const uint64_t n = stat_count.exchange(0);
+  const uint64_t bytes = stat_bytes.exchange(0);
+  const uint64_t exec = stat_exec_us.exchange(0);
+  const uint64_t wait = stat_wait_us.exchange(0);
+  const uint64_t regwaits = stat_regwait_count.exchange(0);
+  const uint64_t regwait_us = stat_regwait_us.exchange(0);
+  REXLOG_INFO(
+      "SUBMIT {:.0f}/s, {:.0f} KB/s | exec {:.1f} ms/s ({:.0f} us each) | waited {:.1f} ms/s "
+      "({:.0f} us each) | WAIT_REG_MEM {:.0f}/s, {:.1f} ms/s",
+      n / seconds, bytes / 1024.0 / seconds, exec / 1000.0 / seconds, n ? double(exec) / n : 0.0,
+      wait / 1000.0 / seconds, n ? double(wait) / n : 0.0, regwaits / seconds,
+      regwait_us / 1000.0 / seconds);
