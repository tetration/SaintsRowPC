+bool CommandProcessor::SubmitCommandStream(const uint8_t* data, uint32_t size_bytes) {
+  if (!data || !size_bytes || (size_bytes & 3) || !worker_running_) {
+    return false;
+  }
+  // A spare dword distinguishes the full linear stream from an empty ring.
+  auto bytes = std::make_shared<std::vector<uint8_t>>(size_bytes + 4);
+  std::memcpy(bytes->data(), data, size_bytes);
+  auto completion = std::make_shared<std::promise<bool>>();
+  auto result = completion->get_future();
+  CallInThread([this, bytes, completion, size_bytes]() {
+    memory::RingBuffer reader(bytes->data(), bytes->size());
+    reader.set_write_offset(size_bytes);
+    const uint32_t resyncs = ExecutePacketsResync(&reader);
+    OnPrimaryBufferEnd();
+    completion->set_value(resyncs < kMaxPacketResyncsPerSpan);
+  });
+  // Bound the wait (e.g. during shutdown); the queued data outlives a timeout.
+  if (result.wait_for(std::chrono::seconds(10)) != std::future_status::ready) {
+    REXGPU_ERROR("Command stream submission timed out");
+    return false;
+  }
+  return result.get();
+}
