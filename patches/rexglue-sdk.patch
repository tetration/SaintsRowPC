+void MarkDone(uint64_t seq) {
+  {
+    std::lock_guard<std::mutex> lock(done_mutex);
+    if (seq > done_seq.load(std::memory_order_relaxed)) {
+      done_seq.store(seq, std::memory_order_release);
+    }
+  }
+  done_cv.notify_all();
+}
+
+// Waits until every submission up to `seq` has executed (bounded, so a lost
+// device or shutdown can't hang the caller forever).
+bool WaitDone(uint64_t seq, const std::atomic<bool>& running) {
+  std::unique_lock<std::mutex> lock(done_mutex);
+  const auto deadline = std::chrono::steady_clock::now() + std::chrono::seconds(10);
+  while (done_seq.load(std::memory_order_acquire) < seq) {
+    if (!running.load() || std::chrono::steady_clock::now() > deadline) {
+      return false;
+    }
+    done_cv.wait_for(lock, std::chrono::milliseconds(50));
+  }
+  return true;
+}
